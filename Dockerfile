# Multi-stage image for ui-registry
# Generated by genproj (docker-container capability, language-aware). Adjust
# for your application.
#
# Stage 1 (build): copies the full source tree, installs dependencies and
# builds the application. Stage 2 (runtime): copies only the build output /
# virtualenv and production dependencies, keeping the final image small.


FROM node:22-slim AS build
WORKDIR /app
# The commit this image is built from, so the page can name its own build.
# `.git` is in `.dockerignore` (the build context should not carry history), so
# `git rev-parse` inside the image answers nothing; CI passes the revision in.
ARG NB_BUILD_COMMIT=unknown
ENV NB_BUILD_COMMIT=$NB_BUILD_COMMIT
COPY package.json package-lock.json* .npmrc* ./
RUN PINNED_NPM="$(node -p "try{require('./package.json').packageManager}catch(e){''}" 2>/dev/null || true)" \
    && if [ -n "$PINNED_NPM" ] && [ "$(npm --version)" != "${PINNED_NPM#npm@}" ]; then \
         echo "Activating pinned ${PINNED_NPM}..."; \
         npm install -g "${PINNED_NPM}" >/dev/null || true; \
       fi \
    && if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/ui-registry so it inherits the
# repo's access (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/ui-registry

ENV NODE_ENV=production
COPY --from=build /app/build ./build
# The registry documents are read from disk at request time by src/routes/r/[...path],
# so they are runtime content, not build inputs. The generated Dockerfile copies only
# `build/`, which would leave the route serving 404s in the image while working locally.
COPY --from=build /app/registry ./registry
COPY --from=build /app/registry.json ./registry.json
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "build/index.js"]
