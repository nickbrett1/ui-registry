# Environment variables for ui-registry (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

# Bearer token required by the registry endpoint (src/routes/r/[...path]).
# The value lives in Doppler, project `common` (see doppler.yaml) -- it does NOT
# belong in this file, and must not be committed: gitleaks scans full history.
# `components.json` in consuming projects references it as
# `Authorization: Bearer ${NB_REGISTRY_TOKEN}`.
NB_REGISTRY_TOKEN=
