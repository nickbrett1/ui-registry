      "content": "<script>\n  /**\n   * RequestForm — schema-driven input form with constraint error presentation.\n   *\n   * Renders input controls from field definitions (not hand-coded HTML).\n   * Displays per-field constraint violations (one message per failed rule)\n   * using the house .notice.bad styling. Lifted from data-download §7.8.\n   */\n  let {\n    title = \"\",\n    fields = [],\n    values = $bindable({}),\n    errors = {},\n    submitLabel = \"Submit\",\n    onsubmit,\n    submitting = false,\n  } = $props();\n\n  function handleSubmit(event) {\n    event.preventDefault();\n    onsubmit?.(values);\n  }\n</script>\n\n<form class=\"card form-card\" onsubmit={handleSubmit}>\n  {#if title}\n    <div class=\"card-head\">\n      <span class=\"micro\">{title}</span>\n    </div>\n  {/if}\n\n  <div class=\"fields\">\n    {#each fields as field}\n      {@const fieldErrors = errors[field.name] ?? []}\n      <div class=\"field-row\">\n        <label for=\"field-{field.name}\" class=\"field-label\">\n          <span class=\"label-text\">{field.label}</span>\n          {#if field.required}\n            <span class=\"required micro\">required</span>\n          {/if}\n        </label>\n\n        {#if field.type === \"checkbox\"}\n          <input\n            id=\"field-{field.name}\"\n            type=\"checkbox\"\n            bind:checked={values[field.name]}\n          />\n        {:else if field.type === \"select\"}\n          <select\n            id=\"field-{field.name}\"\n            class=\"input-select\"\n            bind:value={values[field.name]}\n          >\n            {#each field.options ?? [] as opt}\n              <option value={opt.value}>{opt.label}</option>\n            {/each}\n          </select>\n        {:else if field.type === \"number\"}\n          <input\n            id=\"field-{field.name}\"\n            type=\"number\"\n            class=\"input-text\"\n            placeholder={field.placeholder ?? \"\"}\n            bind:value={values[field.name]}\n          />\n        {:else}\n          <input\n            id=\"field-{field.name}\"\n            type=\"text\"\n            class=\"input-text\"\n            placeholder={field.placeholder ?? \"\"}\n            bind:value={values[field.name]}\n          />\n        {/if}\n\n        {#if field.hint}\n          <span class=\"hint\">{field.hint}</span>\n        {/if}\n\n        <!-- Constraint errors: one message per failed rule -->\n        {#if fieldErrors.length > 0}\n          <div class=\"field-errors\">\n            {#each fieldErrors as err}\n              <div class=\"notice bad\">{err}</div>\n            {/each}\n          </div>\n        {/if}\n      </div>\n    {/each}\n  </div>\n\n  <div class=\"form-actions\">\n    <button type=\"submit\" class=\"btn primary\" disabled={submitting}>\n      {submitting ? \"Submitting…\" : submitLabel}\n    </button>\n  </div>\n</form>\n\n<style>\n  .form-card {\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    max-width: 44rem;\n  }\n\n  .card-head {\n    padding-bottom: 12px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .fields {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .field-row {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n\n  .field-label {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    font-size: 12.5px;\n    font-weight: 500;\n    color: var(--ink-dim);\n  }\n\n  .required {\n    font-size: 9px;\n    color: var(--bad);\n  }\n\n  .input-text,\n  .input-select {\n    background: var(--bg-sunken);\n    border: 1px solid var(--line-strong);\n    border-radius: var(--radius-sm);\n    color: var(--ink);\n    font: inherit;\n    font-size: 13.5px;\n    padding: 7px 10px;\n    width: 100%;\n  }\n\n  .input-select {\n    cursor: pointer;\n  }\n\n  .field-errors {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    margin-top: 4px;\n  }\n\n  .form-actions {\n    display: flex;\n    justify-content: flex-end;\n    padding-top: 12px;\n    border-top: 1px solid var(--line);\n  }\n</style>\n"
    }
  ],
