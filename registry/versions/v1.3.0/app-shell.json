      "content": "<script>\n  /**\n   * AppShell — the house application frame.\n   *\n   * Replaces the bespoke top bars in stratechery-search, deepseek-balance and\n   * data-download. Sticky header with a backdrop blur, wordmark + micro subtitle,\n   * back pill for non-root views, 68rem main, and a footer strip.\n   */\n  let {\n    title = \"Application\",\n    subtitle = \"\",\n    backHref = \"\",\n    backLabel = \"← back\",\n    status = \"\",\n    statusTone = \"ok\",\n    children,\n    footer,\n  } = $props();\n</script>\n\n<div class=\"shell\">\n  <header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <div class=\"brand\">\n        {#if backHref}\n          <a href={backHref} class=\"pill back\">{backLabel}</a>\n        {/if}\n        <div class=\"titles\">\n          {#if subtitle}\n            <span class=\"micro\">{subtitle}</span>\n          {/if}\n          <h1 class=\"wordmark\">{title}</h1>\n        </div>\n      </div>\n      {#if status}\n        <span class=\"pill {statusTone}\">{status}</span>\n      {/if}\n    </div>\n  </header>\n\n  <main class=\"content\">\n    {@render children?.()}\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"footer-inner\">\n      {#if footer}\n        {@render footer()}\n      {:else}\n        <span class=\"micro\">house design system · @nb</span>\n      {/if}\n    </div>\n  </footer>\n</div>\n\n<style>\n  .shell {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    background: var(--bg);\n    color: var(--ink);\n  }\n\n  .topbar {\n    position: sticky;\n    top: 0;\n    z-index: 20;\n    /* Derived from the ground token, not a literal: the bar is the page\n       colour at 88%, which is what makes the blur read as glass. */\n    background: color-mix(in srgb, var(--bg) 88%, transparent);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border-bottom: 1px solid var(--line);\n  }\n\n  .topbar-inner {\n    max-width: 68rem;\n    margin: 0 auto;\n    padding: 12px 16px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n  }\n\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .titles {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .wordmark {\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    color: var(--ink);\n  }\n\n  .back {\n    text-decoration: none;\n  }\n\n  .content {\n    flex: 1;\n    width: 100%;\n    max-width: 68rem;\n    margin: 0 auto;\n    padding: 24px 16px;\n  }\n\n  .footer {\n    border-top: 1px solid var(--line);\n    padding: 16px;\n    background: var(--bg);\n  }\n\n  .footer-inner {\n    max-width: 68rem;\n    margin: 0 auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n</style>\n"
    }
