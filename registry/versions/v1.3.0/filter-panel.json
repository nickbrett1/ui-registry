      "content": "<script>\n  /**\n   * FilterPanel — facet filter bar.\n   *\n   * Desktop: card panel with grouped checkboxes and counts.\n   * Mobile (<600px): chip row that opens a slide-over / bottom sheet so\n   * filters remain usable on small screens without taking over the document.\n   */\n  let {\n    facets = [],\n    selected = {},\n    onchange,\n    onclear,\n  } = $props();\n\n  let mobileOpen = $state(false);\n\n  function isChecked(groupKey, value) {\n    return (selected[groupKey] ?? []).includes(value);\n  }\n\n  function toggle(groupKey, value) {\n    const current = selected[groupKey] ?? [];\n    const next = current.includes(value)\n      ? current.filter((v) => v !== value)\n      : [...current, value];\n    const updated = { ...selected, [groupKey]: next };\n    if (next.length === 0) delete updated[groupKey];\n    onchange?.(updated);\n  }\n\n  const activeCount = $derived(\n    Object.values(selected).reduce((acc, arr) => acc + (arr?.length ?? 0), 0),\n  );\n</script>\n\n<!-- Mobile chip row (<600px) -->\n<div class=\"mobile-chip-row\">\n  <button\n    type=\"button\"\n    class=\"btn mobile-filter-btn\"\n    onclick={() => (mobileOpen = true)}\n  >\n    <span>Filters</span>\n    {#if activeCount > 0}\n      <span class=\"pill info\">{activeCount}</span>\n    {/if}\n  </button>\n  {#if activeCount > 0}\n    <button type=\"button\" class=\"btn clear-btn\" onclick={() => onclear?.()}>\n      Clear all\n    </button>\n  {/if}\n</div>\n\n<!-- Desktop sidebar panel / mobile bottom sheet -->\n<div class=\"filter-panel\" class:mobile-open={mobileOpen}>\n  <div class=\"card panel-card\">\n    <div class=\"panel-header\">\n      <div class=\"panel-title-wrap\">\n        <span class=\"micro\">Filters</span>\n        {#if activeCount > 0}\n          <span class=\"pill info\">{activeCount}</span>\n        {/if}\n      </div>\n      <div class=\"panel-actions\">\n        {#if activeCount > 0}\n          <button type=\"button\" class=\"btn text-btn\" onclick={() => onclear?.()}>\n            Clear\n          </button>\n        {/if}\n        <button\n          type=\"button\"\n          class=\"btn close-btn\"\n          onclick={() => (mobileOpen = false)}\n          aria-label=\"Close filters\"\n        >\n          ✕\n        </button>\n      </div>\n    </div>\n\n    {#each facets as facet}\n      <div class=\"facet-group\">\n        <div class=\"facet-label micro\">{facet.label}</div>\n        <div class=\"facet-options\">\n          {#each facet.options as opt}\n            <label class=\"facet-option\">\n              <input\n                type=\"checkbox\"\n                checked={isChecked(facet.key, opt.value)}\n                onchange={() => toggle(facet.key, opt.value)}\n              />\n              <span class=\"option-label\">{opt.label}</span>\n              {#if opt.count !== undefined}\n                <span class=\"option-count num hint\">{opt.count}</span>\n              {/if}\n            </label>\n          {/each}\n        </div>\n      </div>\n    {/each}\n  </div>\n</div>\n\n{#if mobileOpen}\n  <div\n    class=\"backdrop\"\n    onclick={() => (mobileOpen = false)}\n    role=\"presentation\"\n  ></div>\n{/if}\n\n<style>\n  .mobile-chip-row {\n    display: none;\n    gap: 8px;\n    align-items: center;\n    margin-bottom: 12px;\n  }\n\n  .panel-card {\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .panel-title-wrap {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .panel-actions {\n    display: flex;\n    gap: 6px;\n    align-items: center;\n  }\n\n  .close-btn {\n    display: none;\n    padding: 2px 8px;\n  }\n\n  .text-btn {\n    padding: 2px 8px;\n    font-size: 11px;\n  }\n\n  .facet-group {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n\n  .facet-label {\n    margin: 0;\n  }\n\n  .facet-options {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .facet-option {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 12.5px;\n    cursor: pointer;\n    color: var(--ink-dim);\n    padding: 2px 0;\n  }\n\n  .facet-option:hover {\n    color: var(--ink);\n  }\n\n  .option-label {\n    flex: 1;\n  }\n\n  .option-count {\n    font-size: 11px;\n  }\n\n  .backdrop {\n    display: none;\n  }\n\n  @media (max-width: 600px) {\n    .mobile-chip-row {\n      display: flex;\n    }\n\n    .filter-panel {\n      display: none;\n      position: fixed;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      z-index: 50;\n      max-height: 80vh;\n      overflow-y: auto;\n    }\n\n    .filter-panel.mobile-open {\n      display: block;\n    }\n\n    .panel-card {\n      border-radius: 12px 12px 0 0;\n      border-bottom: 0;\n      background: var(--bg);\n    }\n\n    .close-btn {\n      display: inline-block;\n    }\n\n    .backdrop {\n      display: block;\n      position: fixed;\n      inset: 0;\n      background: color-mix(in srgb, var(--bg) 62%, transparent);\n      z-index: 40;\n    }\n  }\n</style>\n"
    }
  ],
  "meta": {
