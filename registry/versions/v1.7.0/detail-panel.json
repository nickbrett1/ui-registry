      "content": "<script>\n  /**\n   * DetailPanel — entity inspection layout.\n   *\n   * Header with entity title + status pill, two-column metadata grid, and\n   * prose body container. Includes a history-back button so the consumer\n   * needs no navigation state. Lifted from stratechery-search and data-download.\n   */\n  let {\n    title = \"\",\n    pill,\n    meta = [],\n    onback,\n    children,\n  } = $props();\n\n  function handleBack() {\n    if (onback) {\n      onback();\n    } else if (typeof window !== \"undefined\") {\n      window.history.back();\n    }\n  }\n</script>\n\n<div class=\"detail-wrap\">\n  <div class=\"nav-bar\">\n    <button type=\"button\" class=\"pill btn back-btn\" onclick={handleBack}>\n      ← back\n    </button>\n  </div>\n\n  <article class=\"card detail-card\">\n    <header class=\"detail-header\">\n      <h1 class=\"detail-title\">{title}</h1>\n      {#if pill}\n        <span class=\"pill {pill.tone ?? ''}\">{pill.label}</span>\n      {/if}\n    </header>\n\n    {#if meta.length > 0}\n      <dl class=\"meta-grid\">\n        {#each meta as item}\n          <div class=\"meta-cell\">\n            <dt class=\"micro\">{item.label}</dt>\n            <dd class=\"meta-val\" class:num={item.isCode || item.isNum}>\n              {#if item.isCode}\n                <code>{item.value}</code>\n              {:else}\n                {item.value}\n              {/if}\n            </dd>\n          </div>\n        {/each}\n      </dl>\n    {/if}\n\n    <div class=\"detail-body\">\n      {@render children?.()}\n    </div>\n  </article>\n</div>\n\n<style>\n  .detail-wrap {\n    max-width: 52rem;\n    margin: 0 auto;\n  }\n\n  .nav-bar {\n    margin-bottom: 12px;\n  }\n\n  .back-btn {\n    cursor: pointer;\n    background: transparent;\n    border: 1px solid var(--line-strong);\n    color: var(--ink-dim);\n  }\n\n  .detail-card {\n    padding: 24px;\n  }\n\n  .detail-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 16px;\n    padding-bottom: 16px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .detail-title {\n    margin: 0;\n    font-size: 20px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    color: var(--ink);\n    line-height: 1.3;\n  }\n\n  .meta-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 12px 16px;\n    margin: 16px 0;\n    padding: 0;\n  }\n\n  .meta-cell {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .meta-cell dt {\n    margin: 0;\n  }\n\n  .meta-val {\n    margin: 0;\n    font-size: 13px;\n    color: var(--ink-dim);\n  }\n\n  .detail-body {\n    padding-top: 16px;\n    border-top: 1px solid var(--line);\n    font-size: 13.5px;\n    line-height: 1.6;\n    color: var(--ink);\n  }\n\n  @media (max-width: 600px) {\n    .detail-card {\n      padding: 16px;\n    }\n\n    .detail-header {\n      flex-direction: column;\n      gap: 8px;\n    }\n  }\n</style>\n"
    }
  ],
  "meta": {
