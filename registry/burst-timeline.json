      "content": "<script>\n  /**\n   * BurstTimeline — interval chart + historical audit grid.\n   *\n   * Displays an SVG bar sparkline of recent activity intervals followed by a\n   * history table with comparison columns (\"Explains\"). Lifted from\n   * deepseek-balance and data-download §8.\n   */\n  let {\n    intervals = [],\n    history = [],\n    title = \"Activity & History\",\n  } = $props();\n\n  const maxVal = $derived(\n    intervals.reduce((m, x) => Math.max(m, x.count ?? 0), 1),\n  );\n</script>\n\n<div class=\"timeline-wrap\">\n  <div class=\"section-title\">{title}</div>\n\n  <!-- Sparkline burst chart (SVG) -->\n  {#if intervals.length > 0}\n    <div class=\"card chart-card\">\n      <div class=\"micro chart-title\">recent bursts</div>\n      <div class=\"chart-bars\">\n        {#each intervals as interval}\n          {@const heightPct = Math.round(((interval.count ?? 0) / maxVal) * 100)}\n          <div class=\"bar-col\" title=\"{interval.label}: {interval.count}\">\n            <div class=\"bar-track\">\n              <div class=\"bar-fill\" style=\"height: {heightPct}%;\"></div>\n            </div>\n            <span class=\"bar-label num hint\">{interval.label}</span>\n          </div>\n        {/each}\n      </div>\n    </div>\n  {/if}\n\n  <!-- History grid -->\n  {#if history.length > 0}\n    <div class=\"card history-card\">\n      <div class=\"history-head micro\">\n        <span>Timestamp</span>\n        <span>Event</span>\n        <span class=\"num-col\">Value</span>\n        <span>Explains</span>\n      </div>\n      {#each history as row, idx}\n        <div class=\"history-row\" class:border-top={idx > 0}>\n          <span class=\"num hint\">{row.date}</span>\n          <span class=\"row-event\">{row.label}</span>\n          <span class=\"num num-col\">{row.value}</span>\n          <span class=\"row-explains hint\">\n            {#if row.diff}\n              <code class=\"diff-chip\">{row.diff}</code>\n            {/if}\n            {row.note ?? \"\"}\n          </span>\n        </div>\n      {/each}\n    </div>\n  {/if}\n</div>\n\n<style>\n  .timeline-wrap {\n    margin-bottom: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .chart-card {\n    padding: 14px;\n    background: var(--bg-sunken);\n  }\n\n  .chart-title {\n    margin-bottom: 12px;\n  }\n\n  .chart-bars {\n    display: flex;\n    align-items: flex-end;\n    gap: 8px;\n    height: 72px;\n    padding-top: 8px;\n  }\n\n  .bar-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n    height: 100%;\n  }\n\n  .bar-track {\n    width: 100%;\n    flex: 1;\n    background: var(--line);\n    border-radius: 3px;\n    display: flex;\n    align-items: flex-end;\n    overflow: hidden;\n  }\n\n  .bar-fill {\n    width: 100%;\n    background: var(--accent);\n    border-radius: 3px 3px 0 0;\n    min-height: 2px;\n    transition: height 0.2s ease;\n  }\n\n  .bar-label {\n    font-size: 10px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .history-card {\n    overflow: hidden;\n  }\n\n  .history-head {\n    display: grid;\n    grid-template-columns: 140px 1fr 100px 1.5fr;\n    gap: 12px;\n    padding: 8px 12px;\n    border-bottom: 1px solid var(--line);\n    background: var(--bg-sunken);\n  }\n\n  .history-row {\n    display: grid;\n    grid-template-columns: 140px 1fr 100px 1.5fr;\n    gap: 12px;\n    align-items: center;\n    padding: 8px 12px;\n    font-size: 12.5px;\n  }\n\n  .history-row.border-top {\n    border-top: 1px solid var(--line);\n  }\n\n  .num-col {\n    text-align: right;\n  }\n\n  .diff-chip {\n    margin-right: 4px;\n  }\n\n  @media (max-width: 600px) {\n    .history-head,\n    .history-row {\n      grid-template-columns: 1fr;\n      gap: 4px;\n    }\n\n    .num-col {\n      text-align: left;\n    }\n  }\n</style>\n"
    }
  ],
